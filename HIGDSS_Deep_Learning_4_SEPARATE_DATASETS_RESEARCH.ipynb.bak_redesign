{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "HIGDSS — Deep Learning Prediction of Seasonal Groundwater Levels\n",
        "## Four independent research experiments: post-monsoon 1994–2023 and three pre-monsoon periods\n",
        "\n",
        "Each CSV is processed, split, trained, evaluated, and visualized independently.\n",
        "No observations from one CSV are combined with another CSV for training or figures.\n",
        "\n",
        "Models:\n",
        "1. LSTM\n",
        "2. GRU\n",
        "3. CNN-LSTM\n",
        "4. Hybrid LSTM-GRU\n",
        "\n",
        "The supplied files contain monitoring-well location, observation date, and groundwater\n",
        "depth/level. Therefore predictors are restricted to spatial coordinates, calendar variables,\n",
        "and past groundwater observations. No rainfall/temperature/NDVI variables are invented.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "id": "e35b3a59",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "TensorFlow: 2.21.0\n",
            "WARNING:tensorflow:TensorFlow GPU support is not available on native Windows for TensorFlow >= 2.11. Even if CUDA/cuDNN are installed, GPU will not be used. Please use WSL2 or the TensorFlow-DirectML plugin.\n",
            "WARNING: No GPU detected; training will use CPU.\n"
          ]
        }
      ],
      "source": [
        "import os\n",
        "os.environ[\"TF_CPP_MIN_LOG_LEVEL\"] = \"2\"\n",
        "\n",
        "import gc\n",
        "import json\n",
        "import random\n",
        "import time\n",
        "import warnings\n",
        "from pathlib import Path\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import scipy.stats as stats\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.dates as mdates\n",
        "import matplotlib.patches as mpatches\n",
        "\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "from IPython.display import display, HTML\n",
        "\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n",
        "\n",
        "try:\n",
        "    import tensorflow as tf\n",
        "    from tensorflow.keras import Model, Input\n",
        "    from tensorflow.keras.layers import Dense, LSTM, GRU, Conv1D, MaxPooling1D, Dropout\n",
        "    from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau\n",
        "    from tensorflow.keras.optimizers import Adam\n",
        "    print(\"TensorFlow:\", tf.__version__)\n",
        "    GPUS = tf.config.list_physical_devices(\"GPU\")\n",
        "    if GPUS:\n",
        "        for gpu in GPUS:\n",
        "            try:\n",
        "                tf.config.experimental.set_memory_growth(gpu, True)\n",
        "            except RuntimeError:\n",
        "                pass\n",
        "        print(f\"GPU detected: {len(GPUS)} device(s)\")\n",
        "    else:\n",
        "        print(\"WARNING: No GPU detected; training will use CPU.\")\n",
        "except ImportError:\n",
        "    print(\"TensorFlow not installed in current environment; DL training requires TensorFlow/Colab environment.\")\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "SEED = 42\n",
        "random.seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "try:\n",
        "    tf.random.set_seed(SEED)\n",
        "except Exception:\n",
        "    pass\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "id": "d081b4fe",
      "metadata": {},
      "outputs": [],
      "source": [
        "DATASET_FILES = {\n",
        "    \"post_monsoon_1994_2023\": \"post-monsoon_wl_1994-2023.csv\",\n",
        "    \"pre_monsoon_2014_2024\": \"pre-monsoon_2014-2024.csv\",\n",
        "    \"pre_monsoon_2004_2013\": \"pre-monsoon_2004-2013.csv\",\n",
        "    \"pre_monsoon_1994_2003\": \"pre-monsoon_1994-2003.csv\",\n",
        "}\n",
        "\n",
        "LOOKBACK = 4\n",
        "TRAIN_RATIO = 0.70\n",
        "VAL_RATIO = 0.15\n",
        "EPOCHS = 40\n",
        "BATCH_SIZE = 128\n",
        "EARLY_STOPPING_PATIENCE = 8\n",
        "LR_PATIENCE = 3\n",
        "\n",
        "FEATURE_COLS = [\n",
        "    \"LATITUDE\", \"LONGITUDE\",\n",
        "    \"year\", \"month\", \"day_of_year\",\n",
        "    \"month_sin\", \"month_cos\",\n",
        "    \"gw_lag_1\", \"gw_lag_2\", \"gw_lag_3\",\n",
        "    \"gw_change_1\", \"gw_roll_mean_3\", \"gw_roll_std_3\"\n",
        "]\n",
        "\n",
        "MODEL_COLORS = {\n",
        "    \"LSTM\": \"#1f77b4\",\n",
        "    \"GRU\": \"#2ca02c\",\n",
        "    \"CNN-LSTM\": \"#f39c12\",\n",
        "    \"Hybrid LSTM-GRU\": \"#d62728\",\n",
        "}\n",
        "\n",
        "OUTPUT_ROOT = Path(\"outputs\") / \"HIGDSS_DL_4_SEPARATE_DATASETS\"\n",
        "OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "def resolve_file(filename):\n",
        "    exact_candidates = [\n",
        "        Path.cwd() / filename,\n",
        "        Path(\"/content\") / filename,\n",
        "        Path(\"/content/data\") / filename,\n",
        "        Path(\"/mnt/data\") / filename,\n",
        "    ]\n",
        "    for p in exact_candidates:\n",
        "        if p.is_file():\n",
        "            return p\n",
        "    stem = Path(filename).stem\n",
        "    suffix = Path(filename).suffix\n",
        "    for base in [Path.cwd(), Path(\"/content\"), Path(\"/content/data\"), Path(\"/mnt/data\")]:\n",
        "        matches = sorted(base.glob(stem + \"*\" + suffix))\n",
        "        if matches:\n",
        "            return matches[0]\n",
        "    raise FileNotFoundError(\n",
        "        f\"Could not find '{filename}'. Upload the four CSV files to Colab \"\n",
        "        \"or place them beside the notebook.\"\n",
        "    )\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "id": "b970c0f2",
      "metadata": {},
      "outputs": [],
      "source": [
        "def load_and_engineer_dataset(filename):\n",
        "    path = resolve_file(filename)\n",
        "    raw = pd.read_csv(path, low_memory=False)\n",
        "    target_source = \"WL_in_mbgl\" if \"WL_in_mbgl\" in raw.columns else \"DTWL\"\n",
        "\n",
        "    required = [\n",
        "        \"STATE_UT\", \"DISTRICT\", \"BLOCK\", \"VILLAGE\",\n",
        "        \"LATITUDE\", \"LONGITUDE\", \"Date\", target_source\n",
        "    ]\n",
        "    missing = [c for c in required if c not in raw.columns]\n",
        "    if missing:\n",
        "        raise ValueError(\n",
        "            f\"{filename} is missing required columns: {missing}\\n\"\n",
        "            f\"Available columns: {list(raw.columns)}\"\n",
        "        )\n",
        "\n",
        "    df = raw[required].copy()\n",
        "    df[\"date\"] = pd.to_datetime(df[\"Date\"], format=\"%d-%m-%y\", errors=\"coerce\")\n",
        "    df = df.drop(columns=[\"Date\"]).rename(columns={target_source: \"groundwater_level\"})\n",
        "\n",
        "    for c in [\"LATITUDE\", \"LONGITUDE\", \"groundwater_level\"]:\n",
        "        df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n",
        "\n",
        "    df = df.dropna(\n",
        "        subset=[\"date\", \"LATITUDE\", \"LONGITUDE\", \"groundwater_level\"]\n",
        "    ).copy()\n",
        "\n",
        "    df[\"well_id\"] = (\n",
        "        df[[\"STATE_UT\", \"DISTRICT\", \"BLOCK\", \"VILLAGE\", \"LATITUDE\", \"LONGITUDE\"]]\n",
        "        .astype(str)\n",
        "        .agg(\"|\".join, axis=1)\n",
        "    )\n",
        "\n",
        "    df = df.sort_values([\"well_id\", \"date\"]).reset_index(drop=True)\n",
        "\n",
        "    raw_rows = len(df)\n",
        "\n",
        "    df = (\n",
        "        df.groupby([\"well_id\", \"date\"], as_index=False)\n",
        "        .agg({\n",
        "            \"STATE_UT\": \"first\",\n",
        "            \"DISTRICT\": \"first\",\n",
        "            \"BLOCK\": \"first\",\n",
        "            \"VILLAGE\": \"first\",\n",
        "            \"LATITUDE\": \"median\",\n",
        "            \"LONGITUDE\": \"median\",\n",
        "            \"groundwater_level\": \"mean\",\n",
        "        })\n",
        "        .sort_values([\"well_id\", \"date\"])\n",
        "        .reset_index(drop=True)\n",
        "    )\n",
        "\n",
        "    g = df.groupby(\"well_id\", group_keys=False)\n",
        "    df[\"gw_lag_1\"] = g[\"groundwater_level\"].shift(1)\n",
        "    df[\"gw_lag_2\"] = g[\"groundwater_level\"].shift(2)\n",
        "    df[\"gw_lag_3\"] = g[\"groundwater_level\"].shift(3)\n",
        "    df[\"gw_change_1\"] = (\n",
        "        g[\"groundwater_level\"].shift(1)\n",
        "        - g[\"groundwater_level\"].shift(2)\n",
        "    )\n",
        "    df[\"gw_roll_mean_3\"] = g[\"groundwater_level\"].transform(\n",
        "        lambda s: s.shift(1).rolling(window=3, min_periods=1).mean()\n",
        "    )\n",
        "    df[\"gw_roll_std_3\"] = g[\"groundwater_level\"].transform(\n",
        "        lambda s: s.shift(1).rolling(window=3, min_periods=2).std()\n",
        "    )\n",
        "\n",
        "    df[\"year\"] = df[\"date\"].dt.year\n",
        "    df[\"month\"] = df[\"date\"].dt.month\n",
        "    df[\"day_of_year\"] = df[\"date\"].dt.dayofyear\n",
        "    df[\"month_sin\"] = np.sin(2 * np.pi * df[\"month\"] / 12.0)\n",
        "    df[\"month_cos\"] = np.cos(2 * np.pi * df[\"month\"] / 12.0)\n",
        "\n",
        "    df = df.dropna(subset=[\"gw_lag_1\"]).copy()\n",
        "    df[\"gw_lag_2\"] = df[\"gw_lag_2\"].fillna(df[\"gw_lag_1\"])\n",
        "    df[\"gw_lag_3\"] = df[\"gw_lag_3\"].fillna(df[\"gw_lag_2\"])\n",
        "    df[\"gw_change_1\"] = df[\"gw_change_1\"].fillna(0.0)\n",
        "    df[\"gw_roll_std_3\"] = df[\"gw_roll_std_3\"].fillna(0.0)\n",
        "\n",
        "    df = df.sort_values([\"well_id\", \"date\"]).reset_index(drop=True)\n",
        "\n",
        "    info = {\n",
        "        \"source_file\": Path(path).name,\n",
        "        \"usable_rows_after_cleaning\": len(df),\n",
        "        \"unique_wells\": int(df[\"well_id\"].nunique()),\n",
        "        \"date_min\": str(df[\"date\"].min().date()),\n",
        "        \"date_max\": str(df[\"date\"].max().date()),\n",
        "        \"target_column\": target_source,\n",
        "    }\n",
        "    return df, info\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "6a335222",
      "metadata": {},
      "outputs": [],
      "source": [
        "def chronological_split(df):\n",
        "    unique_dates = np.sort(df[\"date\"].dt.normalize().unique())\n",
        "    train_cut = unique_dates[int(len(unique_dates) * TRAIN_RATIO)]\n",
        "    test_cut = unique_dates[int(len(unique_dates) * (TRAIN_RATIO + VAL_RATIO))]\n",
        "\n",
        "    train_df = df[df[\"date\"].dt.normalize() < train_cut].copy()\n",
        "    val_df = df[\n",
        "        (df[\"date\"].dt.normalize() >= train_cut)\n",
        "        & (df[\"date\"].dt.normalize() < test_cut)\n",
        "    ].copy()\n",
        "    test_df = df[df[\"date\"].dt.normalize() >= test_cut].copy()\n",
        "\n",
        "    if min(len(train_df), len(val_df), len(test_df)) == 0:\n",
        "        raise ValueError(\"One chronological partition is empty.\")\n",
        "\n",
        "    return train_df, val_df, test_df, train_cut, test_cut\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "id": "843c28a4",
      "metadata": {},
      "outputs": [],
      "source": [
        "def prepare_sequences(df, train_df, val_df, test_df):\n",
        "    scaler_x = MinMaxScaler()\n",
        "    scaler_y = MinMaxScaler()\n",
        "\n",
        "    scaler_x.fit(train_df[FEATURE_COLS])\n",
        "    scaler_y.fit(train_df[[\"groundwater_level\"]])\n",
        "\n",
        "    all_x = scaler_x.transform(df[FEATURE_COLS]).astype(np.float32)\n",
        "    all_y = scaler_y.transform(df[[\"groundwater_level\"]]).ravel().astype(np.float32)\n",
        "\n",
        "    train_start, train_end = train_df[\"date\"].min(), train_df[\"date\"].max()\n",
        "    val_start, val_end = val_df[\"date\"].min(), val_df[\"date\"].max()\n",
        "    test_start, test_end = test_df[\"date\"].min(), test_df[\"date\"].max()\n",
        "\n",
        "    X_by_split = {\"train\": [], \"val\": [], \"test\": []}\n",
        "    y_by_split = {\"train\": [], \"val\": [], \"test\": []}\n",
        "    d_by_split = {\"train\": [], \"val\": [], \"test\": []}\n",
        "\n",
        "    df_dates = df[\"date\"].to_numpy()\n",
        "\n",
        "    for _, idxs in df.groupby(\"well_id\", sort=False).groups.items():\n",
        "        idxs = np.asarray(list(idxs), dtype=np.int64)\n",
        "        if len(idxs) <= LOOKBACK:\n",
        "            continue\n",
        "\n",
        "        for j in range(LOOKBACK, len(idxs)):\n",
        "            target_idx = idxs[j]\n",
        "            target_date = pd.Timestamp(df_dates[target_idx])\n",
        "\n",
        "            if train_start <= target_date <= train_end:\n",
        "                split = \"train\"\n",
        "            elif val_start <= target_date <= val_end:\n",
        "                split = \"val\"\n",
        "            elif test_start <= target_date <= test_end:\n",
        "                split = \"test\"\n",
        "            else:\n",
        "                continue\n",
        "\n",
        "            history_indices = idxs[j - LOOKBACK:j]\n",
        "            X_by_split[split].append(all_x[history_indices])\n",
        "            y_by_split[split].append(all_y[target_idx])\n",
        "            d_by_split[split].append(target_date)\n",
        "\n",
        "    sequences = {}\n",
        "    for split in [\"train\", \"val\", \"test\"]:\n",
        "        X = np.asarray(X_by_split[split], dtype=np.float32)\n",
        "        y = np.asarray(y_by_split[split], dtype=np.float32).reshape(-1, 1)\n",
        "        dates = pd.to_datetime(d_by_split[split]).to_numpy()\n",
        "        if len(X) == 0:\n",
        "            raise ValueError(f\"No sequences generated for {split}.\")\n",
        "        sequences[split] = {\"X\": X, \"y\": y, \"dates\": dates}\n",
        "\n",
        "    return sequences, scaler_x, scaler_y\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "64337bba",
      "metadata": {},
      "outputs": [],
      "source": [
        "def build_lstm_model(input_shape):\n",
        "    inputs = Input(shape=input_shape)\n",
        "    x = LSTM(64, return_sequences=True)(inputs)\n",
        "    x = Dropout(0.20)(x)\n",
        "    x = LSTM(32)(x)\n",
        "    x = Dropout(0.20)(x)\n",
        "    x = Dense(16, activation=\"relu\")(x)\n",
        "    outputs = Dense(1)(x)\n",
        "    model = Model(inputs, outputs, name=\"LSTM\")\n",
        "    model.compile(optimizer=Adam(0.002), loss=\"mse\", metrics=[\"mae\"])\n",
        "    return model\n",
        "\n",
        "def build_gru_model(input_shape):\n",
        "    inputs = Input(shape=input_shape)\n",
        "    x = GRU(64, return_sequences=True)(inputs)\n",
        "    x = Dropout(0.20)(x)\n",
        "    x = GRU(32)(x)\n",
        "    x = Dropout(0.20)(x)\n",
        "    x = Dense(16, activation=\"relu\")(x)\n",
        "    outputs = Dense(1)(x)\n",
        "    model = Model(inputs, outputs, name=\"GRU\")\n",
        "    model.compile(optimizer=Adam(0.002), loss=\"mse\", metrics=[\"mae\"])\n",
        "    return model\n",
        "\n",
        "def build_cnn_lstm_model(input_shape):\n",
        "    inputs = Input(shape=input_shape)\n",
        "    x = Conv1D(64, 3, padding=\"same\", activation=\"relu\")(inputs)\n",
        "    x = MaxPooling1D(2)(x)\n",
        "    x = LSTM(48)(x)\n",
        "    x = Dropout(0.20)(x)\n",
        "    x = Dense(16, activation=\"relu\")(x)\n",
        "    outputs = Dense(1)(x)\n",
        "    model = Model(inputs, outputs, name=\"CNN-LSTM\")\n",
        "    model.compile(optimizer=Adam(0.002), loss=\"mse\", metrics=[\"mae\"])\n",
        "    return model\n",
        "\n",
        "def build_hybrid_lstm_gru_model(input_shape):\n",
        "    inputs = Input(shape=input_shape)\n",
        "    x = LSTM(64, return_sequences=True)(inputs)\n",
        "    x = Dropout(0.20)(x)\n",
        "    x = GRU(32)(x)\n",
        "    x = Dropout(0.20)(x)\n",
        "    x = Dense(16, activation=\"relu\")(x)\n",
        "    outputs = Dense(1)(x)\n",
        "    model = Model(inputs, outputs, name=\"Hybrid_LSTM_GRU\")\n",
        "    model.compile(optimizer=Adam(0.002), loss=\"mse\", metrics=[\"mae\"])\n",
        "    return model\n",
        "\n",
        "MODEL_BUILDERS = {\n",
        "    \"LSTM\": build_lstm_model,\n",
        "    \"GRU\": build_gru_model,\n",
        "    \"CNN-LSTM\": build_cnn_lstm_model,\n",
        "    \"Hybrid LSTM-GRU\": build_hybrid_lstm_gru_model,\n",
        "}\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "5dfd99fb",
      "metadata": {},
      "outputs": [],
      "source": [
        "def calculate_metrics(observed, predicted):\n",
        "    observed = np.asarray(observed, dtype=float)\n",
        "    predicted = np.asarray(predicted, dtype=float)\n",
        "    error = predicted - observed\n",
        "\n",
        "    mse = float(np.mean(error ** 2))\n",
        "    rmse = float(np.sqrt(mse))\n",
        "    mae = float(np.mean(np.abs(error)))\n",
        "    r2 = float(r2_score(observed, predicted))\n",
        "\n",
        "    if np.std(observed) > 0 and np.std(predicted) > 0:\n",
        "        pearson_r = float(stats.pearsonr(observed, predicted)[0])\n",
        "    else:\n",
        "        pearson_r = np.nan\n",
        "\n",
        "    nse_den = np.sum((observed - np.mean(observed)) ** 2)\n",
        "    nse = float(1 - np.sum((observed - predicted) ** 2) / nse_den) if nse_den > 0 else np.nan\n",
        "\n",
        "    alpha = np.std(predicted) / np.std(observed) if np.std(observed) > 0 else np.nan\n",
        "    beta = np.mean(predicted) / np.mean(observed) if np.mean(observed) != 0 else np.nan\n",
        "    kge = (\n",
        "        float(1 - np.sqrt(\n",
        "            (pearson_r - 1) ** 2 + (alpha - 1) ** 2 + (beta - 1) ** 2\n",
        "        ))\n",
        "        if np.isfinite(pearson_r) else np.nan\n",
        "    )\n",
        "\n",
        "    willmott_den = np.sum(\n",
        "        (np.abs(predicted - np.mean(observed)) +\n",
        "         np.abs(observed - np.mean(observed))) ** 2\n",
        "    )\n",
        "    willmott_d = (\n",
        "        float(1 - np.sum((predicted - observed) ** 2) / willmott_den)\n",
        "        if willmott_den > 0 else np.nan\n",
        "    )\n",
        "\n",
        "    lmi_den = np.sum(np.abs(observed - np.mean(observed)))\n",
        "    lmi = (\n",
        "        float(1 - np.sum(np.abs(predicted - observed)) / lmi_den)\n",
        "        if lmi_den > 0 else np.nan\n",
        "    )\n",
        "\n",
        "    nrmse = (\n",
        "        float(rmse / np.mean(np.abs(observed)))\n",
        "        if np.mean(np.abs(observed)) > 0 else np.nan\n",
        "    )\n",
        "\n",
        "    mape = float(\n",
        "        np.mean(np.abs(error) / np.maximum(np.abs(observed), 1e-6)) * 100\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"RMSE\": rmse, \"MAE\": mae, \"R2\": r2, \"Pearson_r\": pearson_r,\n",
        "        \"KGE\": kge, \"NSE\": nse, \"NRMSE\": nrmse, \"Willmott_d\": willmott_d,\n",
        "        \"LMI\": lmi, \"MSE\": mse, \"MAPE_%\": mape,\n",
        "    }\n",
        "\n",
        "def make_metric_table(predictions, observed):\n",
        "    rows = []\n",
        "    for model_name, pred in predictions.items():\n",
        "        row = {\"Model\": model_name}\n",
        "        row.update(calculate_metrics(observed, pred))\n",
        "        rows.append(row)\n",
        "    return pd.DataFrame(rows)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "id": "633c7d75",
      "metadata": {},
      "outputs": [],
      "source": [
        "# ==============================================================================\n",
        "# ADVANCED PUBLICATION & INTERACTIVE VISUALIZATIONS\n",
        "# Strictly 4 Separate Datasets | Publication-Grade Matplotlib + Interactive Plotly\n",
        "# ==============================================================================\n",
        "\n",
        "plt.rcParams.update({\n",
        "    \"font.family\": \"DejaVu Serif\",\n",
        "    \"font.size\": 10,\n",
        "    \"axes.titlesize\": 12,\n",
        "    \"axes.labelsize\": 11,\n",
        "    \"axes.edgecolor\": \"black\",\n",
        "    \"axes.linewidth\": 1.2,\n",
        "    \"xtick.labelsize\": 9,\n",
        "    \"ytick.labelsize\": 9,\n",
        "})\n",
        "\n",
        "# Reference visual styling constants\n",
        "PLOT_FACE = \"#fbf8e8\"      # Warm cream / parchment background matching reference\n",
        "GRID_COLOR = \"#d5d8dc\"     # Crisp subtle gridlines\n",
        "BORDER_COLOR = \"#000000\"   # Deep solid black spines\n",
        "\n",
        "MODEL_COLORS = {\n",
        "    \"LSTM\": \"#1f77b4\",            # Royal blue\n",
        "    \"GRU\": \"#2ca02c\",             # Emerald green\n",
        "    \"CNN-LSTM\": \"#ff7f0e\",        # Deep orange\n",
        "    \"Hybrid LSTM-GRU\": \"#9467bd\", # Vibrant purple\n",
        "}\n",
        "\n",
        "MODEL_STYLES = {\n",
        "    \"LSTM\": {\"linestyle\": \"--\", \"color\": \"#1f77b4\", \"linewidth\": 1.6},\n",
        "    \"GRU\": {\"linestyle\": \"--\", \"color\": \"#2ca02c\", \"linewidth\": 1.6},\n",
        "    \"CNN-LSTM\": {\"linestyle\": \"-.\", \"color\": \"#ff7f0e\", \"linewidth\": 1.6},\n",
        "    \"Hybrid LSTM-GRU\": {\"linestyle\": \":\", \"color\": \"#9467bd\", \"linewidth\": 1.8},\n",
        "}\n",
        "\n",
        "def style_axis(ax, facecolor=PLOT_FACE):\n",
        "    ax.set_facecolor(facecolor)\n",
        "    ax.grid(True, color=GRID_COLOR, linestyle=\"-\", linewidth=0.7, alpha=0.65)\n",
        "    for spine in ax.spines.values():\n",
        "        spine.set_color(BORDER_COLOR)\n",
        "        spine.set_linewidth(1.3)\n",
        "    ax.tick_params(direction=\"out\", width=1.1, length=4, colors=BORDER_COLOR)\n",
        "\n",
        "def save_and_show_figure(fig, path, dpi=300):\n",
        "    fig.savefig(path, dpi=dpi, bbox_inches=\"tight\", facecolor=\"white\")\n",
        "    plt.show()\n",
        "    plt.close(fig)\n",
        "\n",
        "def save_and_show_plotly(fig, path, width=1200, height=650):\n",
        "    html_path = path.with_suffix(\".html\")\n",
        "    fig.write_html(str(html_path), include_plotlyjs=\"cdn\")\n",
        "    try:\n",
        "        fig.write_image(str(path), width=width, height=height, scale=2)\n",
        "    except Exception:\n",
        "        pass\n",
        "    fig.show()\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 00. OBSERVED REGIONAL TIMELINE\n",
        "# ------------------------------------------------------------------------------\n",
        "def regional_daily_summary(df):\n",
        "    return (\n",
        "        df.groupby(\"date\")[\"groundwater_level\"]\n",
        "        .agg(\n",
        "            observed_mean=\"mean\",\n",
        "            observed_q25=lambda x: x.quantile(0.25),\n",
        "            observed_q75=lambda x: x.quantile(0.75),\n",
        "            n=\"size\",\n",
        "        )\n",
        "        .reset_index()\n",
        "        .sort_values(\"date\")\n",
        "    )\n",
        "\n",
        "def plot_observed_timeline(df, out_path, dataset_title):\n",
        "    summary = regional_daily_summary(df)\n",
        "    fig, ax = plt.subplots(figsize=(15.5, 5.8), dpi=200)\n",
        "    style_axis(ax)\n",
        "    ax.fill_between(\n",
        "        summary[\"date\"], summary[\"observed_q25\"], summary[\"observed_q75\"],\n",
        "        color=\"#9ca3af\", alpha=0.20, label=\"Observed IQR (25th–75th percentile)\"\n",
        "    )\n",
        "    ax.plot(\n",
        "        summary[\"date\"], summary[\"observed_mean\"],\n",
        "        color=\"#111111\", linewidth=2.2, label=\"Observed Regional Mean\"\n",
        "    )\n",
        "    ax.set_title(f\"Regional Observed Groundwater-Level Time Series — {dataset_title}\", fontweight=\"bold\")\n",
        "    ax.set_xlabel(\"Time (Years)\", fontweight=\"bold\")\n",
        "    ax.set_ylabel(\"Groundwater Level (m bgl)\", fontweight=\"bold\")\n",
        "    ax.xaxis.set_major_locator(mdates.YearLocator(2))\n",
        "    ax.xaxis.set_major_formatter(mdates.DateFormatter(\"%Y\"))\n",
        "    ax.legend(loc=\"upper right\", fontsize=8.5, frameon=True, facecolor=\"white\", edgecolor=\"black\")\n",
        "    fig.tight_layout()\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 01. TRAINING & VALIDATION LOSS HISTORIES\n",
        "# ------------------------------------------------------------------------------\n",
        "def plot_loss_histories(histories, out_path, dataset_title):\n",
        "    fig, axes = plt.subplots(2, 2, figsize=(13.5, 9.5), dpi=200)\n",
        "    axes = axes.ravel()\n",
        "    for ax, (name, history) in zip(axes, histories.items()):\n",
        "        h = history.history if hasattr(history, \"history\") else history\n",
        "        ax.plot(h[\"loss\"], color=MODEL_COLORS.get(name, \"#1f77b4\"), linewidth=2.2, label=\"Training MSE\")\n",
        "        ax.plot(h[\"val_loss\"], color=\"black\", linewidth=1.8, linestyle=\"--\", label=\"Validation MSE\")\n",
        "        best_epoch = int(np.argmin(h[\"val_loss\"])) + 1\n",
        "        best_val = float(np.min(h[\"val_loss\"]))\n",
        "        ax.axvline(best_epoch - 1, color=\"#7f1d1d\", linestyle=\":\", linewidth=1.2)\n",
        "        ax.scatter([best_epoch - 1], [best_val], color=\"#7f1d1d\", marker=\"*\", s=90, zorder=5)\n",
        "        ax.set_title(f\"{name}\\nBest validation epoch = {best_epoch}\", fontweight=\"bold\")\n",
        "        ax.set_xlabel(\"Epoch\")\n",
        "        ax.set_ylabel(\"Mean Squared Error (scaled)\")\n",
        "        ax.legend(fontsize=8)\n",
        "        style_axis(ax)\n",
        "    fig.suptitle(f\"Deep Learning Training and Validation Loss — {dataset_title}\", fontweight=\"bold\", fontsize=14)\n",
        "    fig.tight_layout(rect=[0, 0, 1, 0.96])\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 02. TIME SERIES PLOT (Observed vs Predicted — Matching Image 4)\n",
        "# ------------------------------------------------------------------------------\n",
        "def plot_time_series(pred_df, split_date, out_path, dataset_title):\n",
        "    grouped = (\n",
        "        pred_df.groupby(\"Date\")\n",
        "        .agg(\n",
        "            Observed=(\"Observed\", \"mean\"),\n",
        "            Observed_Q25=(\"Observed\", lambda x: x.quantile(0.25)),\n",
        "            Observed_Q75=(\"Observed\", lambda x: x.quantile(0.75)),\n",
        "            **{m: (m, \"mean\") for m in MODEL_COLORS if m in pred_df.columns},\n",
        "        )\n",
        "        .reset_index()\n",
        "        .sort_values(\"Date\")\n",
        "    )\n",
        "    \n",
        "    # 1. Publication Matplotlib Figure\n",
        "    fig, ax = plt.subplots(figsize=(16, 6.8), dpi=200)\n",
        "    style_axis(ax)\n",
        "\n",
        "    # Actual / Observed Line (Bold Red)\n",
        "    ax.plot(\n",
        "        grouped[\"Date\"], grouped[\"Observed\"],\n",
        "        color=\"#e41a1c\", linewidth=2.2, label=\"Actual (DTWL)\", zorder=10\n",
        "    )\n",
        "\n",
        "    # Model Predictions (Dashed lines with distinct colors)\n",
        "    for name, st in MODEL_STYLES.items():\n",
        "        if name in grouped.columns:\n",
        "            ax.plot(\n",
        "                grouped[\"Date\"], grouped[name],\n",
        "                color=st[\"color\"], linestyle=st[\"linestyle\"],\n",
        "                linewidth=st[\"linewidth\"], label=name, alpha=0.92, zorder=6\n",
        "            )\n",
        "\n",
        "    # Train / Test Vertical Split\n",
        "    split_ts = pd.Timestamp(split_date)\n",
        "    ax.axvline(split_ts, color=\"black\", linewidth=2.2, linestyle=\"-.\", label=\"Train-Test Split\", zorder=12)\n",
        "\n",
        "    # Boxed Labels for Training and Testing Data\n",
        "    ymin, ymax = ax.get_ylim()\n",
        "    y_box = ymax - 0.05 * (ymax - ymin)\n",
        "    dates = grouped[\"Date\"].to_numpy()\n",
        "    min_date = pd.Timestamp(dates.min())\n",
        "    max_date = pd.Timestamp(dates.max())\n",
        "    train_center = min_date + (split_ts - min_date) / 2\n",
        "    test_center = split_ts + (max_date - split_ts) / 2\n",
        "\n",
        "    ax.text(\n",
        "        train_center, y_box, \"TRAINING DATA\",\n",
        "        ha=\"center\", va=\"top\", fontsize=10, fontweight=\"bold\",\n",
        "        bbox=dict(facecolor=\"white\", edgecolor=\"black\", boxstyle=\"square,pad=0.4\", linewidth=1.2),\n",
        "        zorder=15\n",
        "    )\n",
        "    ax.text(\n",
        "        test_center, y_box, \"TESTING DATA\",\n",
        "        ha=\"center\", va=\"top\", fontsize=10, fontweight=\"bold\",\n",
        "        bbox=dict(facecolor=\"white\", edgecolor=\"black\", boxstyle=\"square,pad=0.4\", linewidth=1.2),\n",
        "        zorder=15\n",
        "    )\n",
        "\n",
        "    ax.set_title(f\"Time Series Plot for {dataset_title}\", fontweight=\"bold\", fontsize=13, pad=12)\n",
        "    ax.set_xlabel(\"Time (Years)\", fontweight=\"bold\", fontsize=11)\n",
        "    ax.set_ylabel(\"Observed/Predicted DTWL (mbgl)\", fontweight=\"bold\", fontsize=11)\n",
        "    ax.xaxis.set_major_locator(mdates.YearLocator(2))\n",
        "    ax.xaxis.set_major_formatter(mdates.DateFormatter(\"%Y\"))\n",
        "    ax.legend(loc=\"upper right\", fontsize=8.5, ncol=3, frameon=True, facecolor=\"white\", edgecolor=\"black\", framealpha=0.95)\n",
        "    fig.tight_layout()\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "    # 2. Interactive Plotly Figure\n",
        "    plot_time_series_interactive(pred_df, split_date, out_path.with_name(out_path.stem + \"_interactive.png\"), dataset_title)\n",
        "\n",
        "def plot_time_series_interactive(pred_df, split_date, out_path, dataset_title):\n",
        "    grouped = (\n",
        "        pred_df.groupby(\"Date\")\n",
        "        .agg(\n",
        "            Observed=(\"Observed\", \"mean\"),\n",
        "            **{m: (m, \"mean\") for m in MODEL_COLORS if m in pred_df.columns},\n",
        "        )\n",
        "        .reset_index()\n",
        "        .sort_values(\"Date\")\n",
        "    )\n",
        "    fig = go.Figure()\n",
        "    fig.add_trace(go.Scatter(\n",
        "        x=grouped[\"Date\"], y=grouped[\"Observed\"],\n",
        "        mode=\"lines\", name=\"Actual (DTWL)\",\n",
        "        line=dict(color=\"#e41a1c\", width=2.5),\n",
        "        hovertemplate=\"<b>Actual (DTWL)</b><br>Date: %{x|%Y-%m-%d}<br>Level: %{y:.2f} mbgl<extra></extra>\"\n",
        "    ))\n",
        "    dash_map = {\"LSTM\": \"dash\", \"GRU\": \"dot\", \"CNN-LSTM\": \"dashdot\", \"Hybrid LSTM-GRU\": \"longdash\"}\n",
        "    for name, color in MODEL_COLORS.items():\n",
        "        if name in grouped.columns:\n",
        "            fig.add_trace(go.Scatter(\n",
        "                x=grouped[\"Date\"], y=grouped[name],\n",
        "                mode=\"lines\", name=name,\n",
        "                line=dict(color=color, width=1.8, dash=dash_map.get(name, \"dash\")),\n",
        "                hovertemplate=f\"<b>{name}</b><br>Date: %{{x|%Y-%m-%d}}<br>Level: %{{y:.2f}} mbgl<extra></extra>\"\n",
        "            ))\n",
        "    split_str = str(pd.Timestamp(split_date).date())\n",
        "    fig.add_vline(\n",
        "        x=split_str, line_width=2, line_dash=\"dashdot\", line_color=\"black\",\n",
        "        annotation_text=\"Train-Test Split\", annotation_position=\"top left\"\n",
        "    )\n",
        "    fig.update_layout(\n",
        "        title=dict(text=f\"Interactive Time Series Plot for {dataset_title}\", font=dict(size=14, family=\"Arial Black\")),\n",
        "        xaxis=dict(title=\"Time (Years)\", showgrid=True, gridcolor=\"#e5e7eb\", linecolor=\"black\", mirror=True),\n",
        "        yaxis=dict(title=\"Observed/Predicted DTWL (mbgl)\", showgrid=True, gridcolor=\"#e5e7eb\", linecolor=\"black\", mirror=True),\n",
        "        plot_bgcolor=\"#fbf8e8\", paper_bgcolor=\"white\",\n",
        "        legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"right\", x=1, bgcolor=\"rgba(255,255,255,0.9)\", bordercolor=\"black\", borderwidth=1),\n",
        "        margin=dict(l=60, r=40, t=80, b=50),\n",
        "        hovermode=\"x unified\",\n",
        "    )\n",
        "    save_and_show_plotly(fig, out_path)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 03. CORRELATION MATRIX (Matching Image 5)\n",
        "# ------------------------------------------------------------------------------\n",
        "def plot_correlation_matrix(df_or_corr, out_path, dataset_title):\n",
        "    if isinstance(df_or_corr, pd.DataFrame) and \"groundwater_level\" in df_or_corr.columns:\n",
        "        corr_cols = [c for c in FEATURE_COLS if c in df_or_corr.columns] + [\"groundwater_level\"]\n",
        "        corr = df_or_corr[corr_cols].corr()\n",
        "    else:\n",
        "        corr = df_or_corr\n",
        "\n",
        "    valid_cols = [c for c in corr.columns if not corr[c].isna().all()]\n",
        "    corr = corr.loc[valid_cols, valid_cols]\n",
        "    cols = list(corr.columns)\n",
        "    data = corr.values\n",
        "    n = len(cols)\n",
        "    \n",
        "    # 1. Publication Matplotlib Heatmap\n",
        "    fig, ax = plt.subplots(figsize=(max(11, n * 0.75), max(9.5, n * 0.65)), dpi=200)\n",
        "    im = ax.imshow(data, cmap=\"coolwarm\", vmin=-1.0, vmax=1.0, aspect=\"auto\")\n",
        "    ax.set_xticks(np.arange(n))\n",
        "    ax.set_yticks(np.arange(n))\n",
        "    ax.set_xticklabels(cols, rotation=90, ha=\"center\", fontsize=8.5, fontweight=\"bold\")\n",
        "    ax.set_yticklabels(cols, fontsize=8.5, fontweight=\"bold\")\n",
        "    \n",
        "    # White gridlines between cells\n",
        "    ax.set_xticks(np.arange(n + 1) - 0.5, minor=True)\n",
        "    ax.set_yticks(np.arange(n + 1) - 0.5, minor=True)\n",
        "    ax.grid(which=\"minor\", color=\"white\", linestyle=\"-\", linewidth=1.2)\n",
        "    ax.tick_params(which=\"minor\", bottom=False, left=False)\n",
        "    \n",
        "    for i in range(n):\n",
        "        for j in range(n):\n",
        "            val = data[i, j]\n",
        "            text_color = \"white\" if abs(val) > 0.45 else \"black\"\n",
        "            ax.text(\n",
        "                j, i, f\"{val:.2f}\",\n",
        "                ha=\"center\", va=\"center\", fontsize=7.5,\n",
        "                color=text_color, fontweight=\"normal\" if abs(val) < 0.70 else \"bold\"\n",
        "            )\n",
        "            \n",
        "    cbar = fig.colorbar(im, ax=ax, fraction=0.035, pad=0.03)\n",
        "    cbar.set_ticks(np.linspace(-1, 1, 9))\n",
        "    cbar.set_label(\"Pearson Correlation Coefficient\", fontweight=\"bold\", fontsize=10)\n",
        "    cbar.outline.set_edgecolor(\"black\")\n",
        "    cbar.outline.set_linewidth(1.0)\n",
        "    \n",
        "    ax.set_title(f\"Correlation Matrix — {dataset_title}\", fontweight=\"bold\", fontsize=13, pad=14)\n",
        "    fig.tight_layout()\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "    # 2. Interactive Plotly Heatmap\n",
        "    plot_correlation_matrix_interactive(corr, out_path.with_name(out_path.stem + \"_interactive.png\"), dataset_title)\n",
        "\n",
        "def plot_correlation_matrix_interactive(corr, out_path, dataset_title):\n",
        "    cols = list(corr.columns)\n",
        "    z = np.round(corr.values, 2)\n",
        "    fig = go.Figure(data=go.Heatmap(\n",
        "        z=z, x=cols, y=cols,\n",
        "        colorscale=\"RdBu_r\", zmin=-1.0, zmax=1.0,\n",
        "        text=z, texttemplate=\"%{text:.2f}\", textfont={\"size\": 10},\n",
        "        colorbar=dict(title=dict(text=\"Correlation\", font=dict(family=\"Arial\", size=11, color=\"black\"))),\n",
        "        hovertemplate=\"<b>Feature X:</b> %{x}<br><b>Feature Y:</b> %{y}<br><b>Correlation:</b> %{z:.3f}<extra></extra>\"\n",
        "    ))\n",
        "    fig.update_layout(\n",
        "        title=dict(text=f\"Interactive Correlation Matrix — {dataset_title}\", font=dict(size=14, family=\"Arial Black\")),\n",
        "        xaxis=dict(tickangle=-90, tickfont=dict(size=9.5), showgrid=False),\n",
        "        yaxis=dict(tickfont=dict(size=9.5), showgrid=False, autorange=\"reversed\"),\n",
        "        width=850, height=800,\n",
        "        margin=dict(l=120, r=60, t=70, b=120),\n",
        "        paper_bgcolor=\"white\", plot_bgcolor=\"white\"\n",
        "    )\n",
        "    save_and_show_plotly(fig, out_path, width=850, height=800)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 04. SCATTER / PARITY PLOT (Matching Image 2)\n",
        "# ------------------------------------------------------------------------------\n",
        "def plot_parity(predictions_train, obs_train, predictions_test, obs_test, out_path, dataset_title):\n",
        "    # 1. Publication Matplotlib\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(15.5, 6.8), dpi=200)\n",
        "    for ax, phase, predictions, obs in [\n",
        "        (axes[0], \"Training Data\", predictions_train, obs_train),\n",
        "        (axes[1], \"Testing Data\", predictions_test, obs_test),\n",
        "    ]:\n",
        "        style_axis(ax)\n",
        "        obs = np.asarray(obs)\n",
        "\n",
        "        for name, color in MODEL_COLORS.items():\n",
        "            if name in predictions:\n",
        "                pred = np.asarray(predictions[name])\n",
        "                ax.scatter(\n",
        "                    obs, pred, s=14, color=color, alpha=0.45,\n",
        "                    edgecolors=\"none\", label=name, zorder=5\n",
        "                )\n",
        "\n",
        "        lo = float(min(obs.min(), *[np.min(np.asarray(predictions[m])) for m in MODEL_COLORS if m in predictions]))\n",
        "        hi = float(max(obs.max(), *[np.max(np.asarray(predictions[m])) for m in MODEL_COLORS if m in predictions]))\n",
        "        pad = 0.04 * (hi - lo if hi > lo else 1.0)\n",
        "        lim_min, lim_max = max(0, lo - pad), hi + pad\n",
        "\n",
        "        ax.plot(\n",
        "            [lim_min, lim_max], [lim_min, lim_max],\n",
        "            color=\"red\", linestyle=\"--\", linewidth=1.8, label=\"-- 1:1 Line\", zorder=8\n",
        "        )\n",
        "        ax.set_xlim(lim_min, lim_max)\n",
        "        ax.set_ylim(lim_min, lim_max)\n",
        "        ax.set_title(phase, fontweight=\"bold\", fontsize=12)\n",
        "        ax.set_xlabel(\"Observed DTWL (mbgl)\", fontweight=\"bold\", fontsize=10.5)\n",
        "        ax.set_ylabel(\"Predicted DTWL (mbgl)\", fontweight=\"bold\", fontsize=10.5)\n",
        "\n",
        "        ax.legend(\n",
        "            loc=\"upper left\", fontsize=8, frameon=True,\n",
        "            facecolor=\"white\", edgecolor=\"black\", framealpha=0.92, ncol=2\n",
        "        )\n",
        "\n",
        "    fig.suptitle(f\"{dataset_title} — Observed vs Predicted GWL\", fontsize=14, fontweight=\"bold\", y=0.98)\n",
        "    fig.tight_layout(rect=[0, 0, 1, 0.95])\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "    # 2. Interactive Plotly\n",
        "    plot_parity_interactive(predictions_train, obs_train, predictions_test, obs_test, out_path.with_name(out_path.stem + \"_interactive.png\"), dataset_title)\n",
        "\n",
        "def plot_parity_interactive(predictions_train, obs_train, predictions_test, obs_test, out_path, dataset_title):\n",
        "    fig = make_subplots(rows=1, cols=2, subplot_titles=[\"Training Data\", \"Testing Data\"])\n",
        "    for col_idx, (phase, preds, obs) in enumerate([\n",
        "        (\"Training\", predictions_train, obs_train),\n",
        "        (\"Testing\", predictions_test, obs_test),\n",
        "    ], start=1):\n",
        "        obs = np.asarray(obs)\n",
        "        for name, color in MODEL_COLORS.items():\n",
        "            if name in preds:\n",
        "                pred = np.asarray(preds[name])\n",
        "                if len(obs) > 5000:\n",
        "                    idx = np.random.default_rng(42).choice(len(obs), 5000, replace=False)\n",
        "                    x_pts, y_pts = obs[idx], pred[idx]\n",
        "                else:\n",
        "                    x_pts, y_pts = obs, pred\n",
        "                fig.add_trace(go.Scatter(\n",
        "                    x=x_pts, y=y_pts,\n",
        "                    mode=\"markers\", name=name,\n",
        "                    legendgroup=name, showlegend=(col_idx == 1),\n",
        "                    marker=dict(color=color, size=5, opacity=0.5),\n",
        "                    hovertemplate=f\"<b>{name} ({phase})</b><br>Observed: %{{x:.2f}} mbgl<br>Predicted: %{{y:.2f}} mbgl<extra></extra>\"\n",
        "                ), row=1, col=col_idx)\n",
        "\n",
        "        lo = float(obs.min())\n",
        "        hi = float(obs.max())\n",
        "        fig.add_trace(go.Scatter(\n",
        "            x=[lo, hi], y=[lo, hi],\n",
        "            mode=\"lines\", name=\"1:1 Line\",\n",
        "            legendgroup=\"1:1 Line\", showlegend=(col_idx == 1),\n",
        "            line=dict(color=\"red\", dash=\"dash\", width=2),\n",
        "            hoverinfo=\"skip\"\n",
        "        ), row=1, col=col_idx)\n",
        "\n",
        "    fig.update_xaxes(title_text=\"Observed DTWL (mbgl)\", showgrid=True, gridcolor=\"#e5e7eb\", linecolor=\"black\", mirror=True)\n",
        "    fig.update_yaxes(title_text=\"Predicted DTWL (mbgl)\", showgrid=True, gridcolor=\"#e5e7eb\", linecolor=\"black\", mirror=True)\n",
        "    fig.update_layout(\n",
        "        title=dict(text=f\"Interactive Observed vs Predicted DTWL — {dataset_title}\", font=dict(size=14, family=\"Arial Black\")),\n",
        "        plot_bgcolor=\"#fbf8e8\", paper_bgcolor=\"white\",\n",
        "        legend=dict(bgcolor=\"rgba(255,255,255,0.9)\", bordercolor=\"black\", borderwidth=1),\n",
        "        margin=dict(l=60, r=40, t=80, b=50),\n",
        "    )\n",
        "    save_and_show_plotly(fig, out_path)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 05. TEST RESIDUALS OVER TIME\n",
        "# ------------------------------------------------------------------------------\n",
        "def plot_residuals(pred_df, out_path, dataset_title):\n",
        "    fig, ax = plt.subplots(figsize=(16, 6), dpi=200)\n",
        "    style_axis(ax)\n",
        "    for name, color in MODEL_COLORS.items():\n",
        "        if name in pred_df.columns:\n",
        "            residual = pred_df[name] - pred_df[\"Observed\"]\n",
        "            ax.plot(pred_df[\"Date\"], residual, color=color, linewidth=0.9, alpha=0.70, label=name)\n",
        "    ax.axhline(0, color=\"black\", linestyle=\"--\", linewidth=1.5)\n",
        "    ax.set_title(f\"Chronological Prediction Residuals — {dataset_title}\", fontweight=\"bold\")\n",
        "    ax.set_xlabel(\"Time (Years)\", fontweight=\"bold\")\n",
        "    ax.set_ylabel(\"Prediction Error (m)\", fontweight=\"bold\")\n",
        "    ax.xaxis.set_major_locator(mdates.YearLocator(2))\n",
        "    ax.xaxis.set_major_formatter(mdates.DateFormatter(\"%Y\"))\n",
        "    ax.legend(ncol=2, fontsize=8.5, frameon=True, facecolor=\"white\", edgecolor=\"black\")\n",
        "    fig.tight_layout()\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 06. RESIDUAL ERROR DISTRIBUTIONS\n",
        "# ------------------------------------------------------------------------------\n",
        "def plot_error_distributions(pred_df, out_path, dataset_title):\n",
        "    fig, axes = plt.subplots(2, 2, figsize=(14, 9), dpi=200)\n",
        "    axes = axes.ravel()\n",
        "    for ax, (name, color) in zip(axes, MODEL_COLORS.items()):\n",
        "        if name not in pred_df.columns:\n",
        "            continue\n",
        "        style_axis(ax)\n",
        "        errors = (pred_df[name] - pred_df[\"Observed\"]).dropna().to_numpy()\n",
        "        q01, q99 = np.quantile(errors, [0.01, 0.99])\n",
        "        span = max(abs(q01), abs(q99), 1.0)\n",
        "        lim = max(2.0, min(20.0, span * 1.10))\n",
        "        bins = np.linspace(-lim, lim, 41)\n",
        "        ax.hist(\n",
        "            errors, bins=bins, weights=np.ones(len(errors)) * 100.0 / len(errors),\n",
        "            color=color, alpha=0.48, edgecolor=color, linewidth=0.7\n",
        "        )\n",
        "\n",
        "        if len(errors) >= 20 and np.std(errors) > 0:\n",
        "            sample = errors\n",
        "            if len(sample) > 30000:\n",
        "                sample = np.random.default_rng(SEED).choice(sample, 30000, replace=False)\n",
        "            kde = stats.gaussian_kde(sample)\n",
        "            x = np.linspace(-lim, lim, 300)\n",
        "            bin_width = bins[1] - bins[0]\n",
        "            ax.plot(x, kde(x) * bin_width * 100, color=color, linewidth=2.0)\n",
        "\n",
        "        mean_error = float(np.mean(errors))\n",
        "        ax.axvline(0, color=\"black\", linestyle=\"--\", linewidth=1.3)\n",
        "        ax.axvline(mean_error, color=\"#7f1d1d\", linestyle=\":\", linewidth=1.3)\n",
        "        ax.set_xlim(-lim, lim)\n",
        "        ax.set_xlabel(\"Prediction Error (m)\", fontweight=\"bold\")\n",
        "        ax.set_ylabel(\"Frequency (%)\", fontweight=\"bold\")\n",
        "        ax.set_title(name, fontweight=\"bold\")\n",
        "        ax.text(\n",
        "            0.97, 0.96,\n",
        "            f\"Mean = {mean_error:+.3f} m\\nRMSE = {np.sqrt(np.mean(errors**2)):.3f} m\\nMAE = {np.mean(np.abs(errors)):.3f} m\",\n",
        "            transform=ax.transAxes, ha=\"right\", va=\"top\", fontsize=8.5,\n",
        "            bbox=dict(boxstyle=\"round,pad=0.35\", facecolor=\"white\", edgecolor=color, alpha=0.92)\n",
        "        )\n",
        "    fig.suptitle(f\"Prediction Error Frequency Distributions — {dataset_title}\", fontsize=14, fontweight=\"bold\")\n",
        "    fig.tight_layout(rect=[0, 0, 1, 0.95])\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 07. TAYLOR DIAGRAM (Matching Image 3)\n",
        "# ------------------------------------------------------------------------------\n",
        "def make_taylor_dataframe(predictions, observed):\n",
        "    obs_std = float(np.std(observed))\n",
        "    records = []\n",
        "    for name, pred in predictions.items():\n",
        "        pred_std = float(np.std(pred))\n",
        "        r = (float(stats.pearsonr(observed, pred)[0])\n",
        "             if np.std(observed) > 0 and np.std(pred) > 0 else np.nan)\n",
        "        crmse = (float(np.sqrt(obs_std**2 + pred_std**2 - 2 * obs_std * pred_std * r))\n",
        "                 if np.isfinite(r) else np.nan)\n",
        "        records.append({\n",
        "            \"Model\": name,\n",
        "            \"Observed_STD\": obs_std,\n",
        "            \"Predicted_STD\": pred_std,\n",
        "            \"Normalized_STD\": pred_std / obs_std if obs_std > 0 else np.nan,\n",
        "            \"Pearson_r\": r,\n",
        "            \"Centered_RMSE\": crmse,\n",
        "            \"Normalized_CRMSE\": crmse / obs_std if obs_std > 0 else np.nan,\n",
        "        })\n",
        "    result = pd.DataFrame(records)\n",
        "    result.attrs[\"obs_std\"] = obs_std\n",
        "    return result\n",
        "\n",
        "def plot_taylor(metrics_by_phase, out_path, dataset_title):\n",
        "    fig = plt.figure(figsize=(14.5, 6.8), dpi=200)\n",
        "    axes = [\n",
        "        fig.add_subplot(1, 2, 1, projection=\"polar\"),\n",
        "        fig.add_subplot(1, 2, 2, projection=\"polar\"),\n",
        "    ]\n",
        "\n",
        "    for ax, phase in zip(axes, [\"Training\", \"Testing\"]):\n",
        "        ax.set_facecolor(PLOT_FACE)\n",
        "        phase_df = metrics_by_phase[phase]\n",
        "        max_r = max(1.50, float(phase_df[\"Normalized_STD\"].max()) * 1.18)\n",
        "        theta = np.linspace(0, np.pi / 2, 250)\n",
        "\n",
        "        for radius in [0.25, 0.5, 0.75, 1.0, 1.25, 1.5]:\n",
        "            if radius <= max_r:\n",
        "                ax.plot(theta, np.full_like(theta, radius), color=\"#bfc5cc\", linestyle=\":\", linewidth=0.8)\n",
        "\n",
        "        corr_ticks = [0.1, 0.3, 0.5, 0.7, 0.8, 0.9, 0.95, 0.99, 1.0]\n",
        "        for corr in corr_ticks:\n",
        "            angle = np.arccos(np.clip(corr, -1, 1))\n",
        "            ax.plot([angle, angle], [0, max_r], color=\"#bfc5cc\", linestyle=\"--\", linewidth=0.7)\n",
        "\n",
        "        # Centered RMSE Contours\n",
        "        r_grid = np.linspace(0, max_r, 200)\n",
        "        t_grid = np.linspace(0, np.pi / 2, 200)\n",
        "        R, T = np.meshgrid(r_grid, t_grid)\n",
        "        crmse = np.sqrt(1 + R**2 - 2 * R * np.cos(T))\n",
        "        cs = ax.contour(\n",
        "            T, R, crmse,\n",
        "            levels=[0.25, 0.5, 0.75, 1.0, 1.25],\n",
        "            colors=\"#64b5f6\", linewidths=0.75, alpha=0.85,\n",
        "        )\n",
        "        ax.clabel(cs, inline=True, fontsize=7.5, fmt=\"%.2f\")\n",
        "\n",
        "        # Gold Star for Observed Reference Point\n",
        "        ax.scatter(\n",
        "            [0], [1], marker=\"*\", s=180, color=\"#f59e0b\",\n",
        "            edgecolor=\"black\", linewidth=1.0, zorder=12, label=\"★ Observed\"\n",
        "        )\n",
        "\n",
        "        for name, color in MODEL_COLORS.items():\n",
        "            sub = phase_df[phase_df[\"Model\"] == name]\n",
        "            if not sub.empty:\n",
        "                row = sub.iloc[0]\n",
        "                angle = np.arccos(np.clip(row[\"Pearson_r\"], -1, 1))\n",
        "                ax.scatter(\n",
        "                    [angle], [row[\"Normalized_STD\"]], s=75, color=color,\n",
        "                    edgecolor=\"black\", linewidth=0.9, label=name, zorder=10\n",
        "                )\n",
        "\n",
        "        ax.set_thetamin(0)\n",
        "        ax.set_thetamax(90)\n",
        "        ax.set_rlim(0, max_r)\n",
        "        ax.set_rlabel_position(84)\n",
        "        ax.set_title(f\"({'a' if phase == 'Training' else 'b'}) {phase} phase\", fontweight=\"bold\", pad=18, fontsize=11)\n",
        "        ax.set_xticks(np.arccos(np.array(corr_ticks)))\n",
        "        ax.set_xticklabels([str(c) for c in corr_ticks], fontsize=7.5)\n",
        "\n",
        "    axes[0].set_ylabel(\"Normalized standard deviation\", labelpad=28, fontweight=\"bold\")\n",
        "    axes[1].set_ylabel(\"Normalized standard deviation\", labelpad=28, fontweight=\"bold\")\n",
        "    axes[1].legend(\n",
        "        loc=\"upper right\", bbox_to_anchor=(1.35, 1.10), fontsize=8.5,\n",
        "        frameon=True, facecolor=\"white\", edgecolor=\"black\"\n",
        "    )\n",
        "\n",
        "    fig.suptitle(f\"Taylor Diagram ({dataset_title})\", fontsize=14, fontweight=\"bold\", y=0.98)\n",
        "    fig.tight_layout(rect=[0, 0, 0.92, 0.94])\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 08. MODEL PERFORMANCE GRAPH (Fixing Image 1)\n",
        "# ------------------------------------------------------------------------------\n",
        "def plot_performance(train_metrics, test_metrics, out_path, dataset_title):\n",
        "    models = [m for m in MODEL_COLORS if m in test_metrics[\"Model\"].values]\n",
        "    test_i = test_metrics.set_index(\"Model\").loc[models]\n",
        "    x = np.arange(len(models))\n",
        "    width = 0.35\n",
        "\n",
        "    # 1. Publication Dual-Axis Plot with Scaled Axes and Direct Labels\n",
        "    fig, ax1 = plt.subplots(figsize=(12, 6.5), dpi=200)\n",
        "    style_axis(ax1, facecolor=\"white\")\n",
        "\n",
        "    r2_vals = test_i[\"R2\"].to_numpy()\n",
        "    nse_vals = test_i[\"NSE\"].to_numpy()\n",
        "    rmse_vals = test_i[\"RMSE\"].to_numpy()\n",
        "\n",
        "    bar1 = ax1.bar(x - width/2, r2_vals, width, label=\"R²\", color=\"#2563eb\", edgecolor=\"black\", linewidth=0.8)\n",
        "    bar2 = ax1.bar(x + width/2, nse_vals, width, label=\"NSE\", color=\"#16a34a\", edgecolor=\"black\", linewidth=0.8)\n",
        "\n",
        "    min_score = min(np.min(r2_vals), np.min(nse_vals))\n",
        "    max_score = max(np.max(r2_vals), np.max(nse_vals))\n",
        "    y1_min = max(-0.1, min_score - 0.15)\n",
        "    y1_max = min(1.05, max_score + 0.15)\n",
        "    ax1.set_ylim(y1_min, y1_max)\n",
        "    ax1.set_ylabel(\"Metric Score (R² / NSE)\", fontweight=\"bold\", fontsize=11)\n",
        "    ax1.set_xlabel(\"Deep Learning Models\", fontweight=\"bold\", fontsize=11)\n",
        "\n",
        "    for rect in bar1:\n",
        "        height = rect.get_height()\n",
        "        ax1.annotate(\n",
        "            f\"{height:.3f}\",\n",
        "            xy=(rect.get_x() + rect.get_width() / 2, height),\n",
        "            xytext=(0, 3), textcoords=\"offset points\",\n",
        "            ha=\"center\", va=\"bottom\", fontsize=8, fontweight=\"bold\", color=\"#1e3a8a\"\n",
        "        )\n",
        "    for rect in bar2:\n",
        "        height = rect.get_height()\n",
        "        ax1.annotate(\n",
        "            f\"{height:.3f}\",\n",
        "            xy=(rect.get_x() + rect.get_width() / 2, height),\n",
        "            xytext=(0, 3), textcoords=\"offset points\",\n",
        "            ha=\"center\", va=\"bottom\", fontsize=8, fontweight=\"bold\", color=\"#14532d\"\n",
        "        )\n",
        "\n",
        "    ax2 = ax1.twinx()\n",
        "    ax2.plot(\n",
        "        x, rmse_vals, color=\"#dc2626\", linewidth=2.4, marker=\"o\",\n",
        "        markersize=8, label=\"RMSE\", zorder=10\n",
        "    )\n",
        "    y2_min = max(0, float(np.min(rmse_vals)) * 0.85)\n",
        "    y2_max = float(np.max(rmse_vals)) * 1.20\n",
        "    ax2.set_ylim(y2_min, y2_max)\n",
        "    ax2.set_ylabel(\"RMSE (mbgl)\", fontweight=\"bold\", fontsize=11, color=\"#dc2626\")\n",
        "    ax2.tick_params(axis=\"y\", labelcolor=\"#dc2626\")\n",
        "\n",
        "    for i, val in enumerate(rmse_vals):\n",
        "        ax2.annotate(\n",
        "            f\"{val:.2f}m\", xy=(x[i], val), xytext=(0, 7),\n",
        "            textcoords=\"offset points\", ha=\"center\", fontsize=8.5,\n",
        "            fontweight=\"bold\", color=\"#b91c1c\"\n",
        "        )\n",
        "\n",
        "    ax1.set_xticks(x)\n",
        "    ax1.set_xticklabels(models, rotation=15, ha=\"right\", fontsize=9.5, fontweight=\"bold\")\n",
        "\n",
        "    lines, labels = ax1.get_legend_handles_labels()\n",
        "    lines2, labels2 = ax2.get_legend_handles_labels()\n",
        "    ax1.legend(lines + lines2, labels + labels2, loc=\"upper left\", fontsize=9, frameon=True, facecolor=\"white\", edgecolor=\"black\")\n",
        "\n",
        "    ax1.set_title(f\"ML Model Performance Comparison — {dataset_title}\", fontweight=\"bold\", fontsize=13, pad=14)\n",
        "    fig.tight_layout()\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "    # 2. Interactive Plotly Performance Chart\n",
        "    plot_performance_interactive(train_metrics, test_metrics, out_path.with_name(out_path.stem + \"_interactive.png\"), dataset_title)\n",
        "\n",
        "def plot_performance_interactive(train_metrics, test_metrics, out_path, dataset_title):\n",
        "    models = [m for m in MODEL_COLORS if m in test_metrics[\"Model\"].values]\n",
        "    test_i = test_metrics.set_index(\"Model\").loc[models]\n",
        "\n",
        "    fig = make_subplots(specs=[[{\"secondary_y\": True}]])\n",
        "    fig.add_trace(go.Bar(\n",
        "        x=models, y=test_i[\"R2\"],\n",
        "        name=\"R²\", marker_color=\"#2563eb\",\n",
        "        text=test_i[\"R2\"].round(3), textposition=\"auto\",\n",
        "        hovertemplate=\"<b>%{x}</b><br>R²: %{y:.4f}<extra></extra>\"\n",
        "    ), secondary_y=False)\n",
        "\n",
        "    fig.add_trace(go.Bar(\n",
        "        x=models, y=test_i[\"NSE\"],\n",
        "        name=\"NSE\", marker_color=\"#16a34a\",\n",
        "        text=test_i[\"NSE\"].round(3), textposition=\"auto\",\n",
        "        hovertemplate=\"<b>%{x}</b><br>NSE: %{y:.4f}<extra></extra>\"\n",
        "    ), secondary_y=False)\n",
        "\n",
        "    fig.add_trace(go.Scatter(\n",
        "        x=models, y=test_i[\"RMSE\"],\n",
        "        name=\"RMSE\", mode=\"lines+markers+text\",\n",
        "        text=test_i[\"RMSE\"].round(2).astype(str) + \"m\",\n",
        "        textposition=\"top center\",\n",
        "        line=dict(color=\"#dc2626\", width=3),\n",
        "        marker=dict(size=9, color=\"#dc2626\"),\n",
        "        hovertemplate=\"<b>%{x}</b><br>RMSE: %{y:.3f} mbgl<extra></extra>\"\n",
        "    ), secondary_y=True)\n",
        "\n",
        "    fig.update_layout(\n",
        "        title=dict(text=f\"Interactive Model Performance — {dataset_title}\", font=dict(size=14, family=\"Arial Black\")),\n",
        "        xaxis=dict(title=\"Model\", linecolor=\"black\", mirror=True),\n",
        "        yaxis=dict(title=\"Score (R² / NSE)\", linecolor=\"black\", mirror=True, showgrid=True),\n",
        "        yaxis2=dict(title=\"RMSE (mbgl)\", linecolor=\"#dc2626\", overlaying=\"y\", side=\"right\", showgrid=False),\n",
        "        barmode=\"group\",\n",
        "        plot_bgcolor=\"#fbf8e8\", paper_bgcolor=\"white\",\n",
        "        legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"right\", x=1, bgcolor=\"rgba(255,255,255,0.9)\", bordercolor=\"black\", borderwidth=1),\n",
        "        margin=dict(l=60, r=60, t=80, b=60),\n",
        "    )\n",
        "    save_and_show_plotly(fig, out_path)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 09. STATISTICAL METRICS TABLE (Academic Color Coded)\n",
        "# ------------------------------------------------------------------------------\n",
        "def plot_statistical_tables(train_metrics, test_metrics, out_path, dataset_title):\n",
        "    metric_order = [\n",
        "        \"RMSE\", \"MAE\", \"R2\", \"Pearson_r\", \"KGE\",\n",
        "        \"NSE\", \"NRMSE\", \"Willmott_d\", \"LMI\", \"MSE\", \"MAPE_%\"\n",
        "    ]\n",
        "    models = [m for m in MODEL_COLORS if m in train_metrics[\"Model\"].values]\n",
        "    train = train_metrics.set_index(\"Model\").loc[models, metric_order]\n",
        "    test = test_metrics.set_index(\"Model\").loc[models, metric_order]\n",
        "\n",
        "    labels = {\n",
        "        \"RMSE\": \"RMSE (m)\", \"MAE\": \"MAE (m)\", \"R2\": \"R²\", \"Pearson_r\": \"Pearson r\",\n",
        "        \"KGE\": \"KGE\", \"NSE\": \"NSE\", \"NRMSE\": \"NRMSE\",\n",
        "        \"Willmott_d\": \"Willmott's d\", \"LMI\": \"LMI\", \"MSE\": \"MSE\",\n",
        "        \"MAPE_%\": \"MAPE (%)\",\n",
        "    }\n",
        "    row_labels = [labels[m] for m in metric_order]\n",
        "\n",
        "    # 1. Publication Figure Table\n",
        "    fig = plt.figure(figsize=(15.5, 9.8), dpi=200)\n",
        "    fig.patch.set_facecolor(\"white\")\n",
        "    fig.text(\n",
        "        0.5, 0.975,\n",
        "        f\"Statistical Performance Metrics for Deep Learning Models — {dataset_title}\",\n",
        "        ha=\"center\", va=\"top\", fontsize=14, fontweight=\"bold\", color=\"#0f172a\"\n",
        "    )\n",
        "\n",
        "    def add_styled_table(ax, frame, title, header_bg=\"#1e3a8a\"):\n",
        "        ax.axis(\"off\")\n",
        "        cell_text = [\n",
        "            [row_labels[i]] + [f\"{frame.loc[m, metric_order[i]]:.3f}\" for m in models]\n",
        "            for i in range(len(metric_order))\n",
        "        ]\n",
        "        col_labels = [\"Statistical Index\"] + models\n",
        "        table = ax.table(\n",
        "            cellText=cell_text, colLabels=col_labels,\n",
        "            cellLoc=\"center\", colLoc=\"center\", loc=\"center\",\n",
        "            bbox=[0, 0.03, 1, 0.77],\n",
        "        )\n",
        "        table.auto_set_font_size(False)\n",
        "        table.set_fontsize(9.0)\n",
        "\n",
        "        for (r, c), cell in table.get_celld().items():\n",
        "            cell.set_edgecolor(\"#94a3b8\")\n",
        "            cell.set_linewidth(0.8)\n",
        "            if r == 0:\n",
        "                cell.set_text_props(fontweight=\"bold\", color=\"white\")\n",
        "                cell.set_facecolor(header_bg if c > 0 else \"#334155\")\n",
        "            else:\n",
        "                cell.set_facecolor(\"#ffffff\" if r % 2 == 1 else \"#f8fafc\")\n",
        "                if c == 0:\n",
        "                    cell.set_text_props(fontweight=\"bold\", color=\"#1e293b\")\n",
        "\n",
        "        for i, metric in enumerate(metric_order, start=1):\n",
        "            values = frame.loc[models, metric].astype(float).to_numpy()\n",
        "            if np.all(np.isnan(values)):\n",
        "                continue\n",
        "            best_idx = (\n",
        "                int(np.nanargmin(values))\n",
        "                if metric in [\"RMSE\", \"MAE\", \"NRMSE\", \"MSE\", \"MAPE_%\"]\n",
        "                else int(np.nanargmax(values))\n",
        "            )\n",
        "            best_cell = table[(i, best_idx + 1)]\n",
        "            best_cell.set_facecolor(\"#dcfce7\")\n",
        "            best_cell.set_text_props(fontweight=\"bold\", color=\"#166534\")\n",
        "\n",
        "        ax.text(\n",
        "            0.5, 0.85, title, ha=\"center\", va=\"bottom\",\n",
        "            fontsize=11.5, fontweight=\"bold\", color=\"white\",\n",
        "            bbox=dict(boxstyle=\"square,pad=0.4\", facecolor=header_bg, edgecolor=\"black\", linewidth=0.9),\n",
        "        )\n",
        "\n",
        "    add_styled_table(fig.add_axes([0.055, 0.53, 0.89, 0.39]), train, \"Training Phase Performance\", header_bg=\"#1e3a8a\")\n",
        "    add_styled_table(fig.add_axes([0.055, 0.07, 0.89, 0.39]), test, \"Testing Phase Performance\", header_bg=\"#0284c7\")\n",
        "\n",
        "    fig.text(\n",
        "        0.055, 0.02,\n",
        "        \"Color Code: Mint green cell denotes best performing model for that index. \"\n",
        "        \"Lower is better for RMSE, MAE, NRMSE, MSE, MAPE; Higher is better for R², Pearson r, KGE, NSE, Willmott's d, LMI.\",\n",
        "        fontsize=8.5, color=\"#475569\"\n",
        "    )\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n",
        "\n",
        "    # 2. Interactive Plotly Table Display\n",
        "    fig_table = go.Figure(data=[go.Table(\n",
        "        header=dict(\n",
        "            values=[\"<b>Statistical Index</b>\"] + [f\"<b>{m}</b>\" for m in models],\n",
        "            fill_color=\"#1e3a8a\",\n",
        "            font=dict(color=\"white\", size=11),\n",
        "            align=\"center\"\n",
        "        ),\n",
        "        cells=dict(\n",
        "            values=[[row_labels[i] for i in range(len(metric_order))]] + [\n",
        "                [f\"{test.loc[m, metric_order[i]]:.3f}\" for i in range(len(metric_order))]\n",
        "                for m in models\n",
        "            ],\n",
        "            fill_color=[[\"#f1f5f9\" if r % 2 == 0 else \"#ffffff\" for r in range(len(metric_order))]] + [\n",
        "                [\"#ffffff\" for _ in range(len(metric_order))] for _ in models\n",
        "            ],\n",
        "            font=dict(color=\"#0f172a\", size=10.5),\n",
        "            align=\"center\",\n",
        "            height=28\n",
        "        )\n",
        "    )])\n",
        "    fig_table.update_layout(\n",
        "        title=dict(text=f\"Testing Phase Statistical Performance Metrics — {dataset_title}\", font=dict(size=13, family=\"Arial Black\")),\n",
        "        margin=dict(l=20, r=20, t=50, b=20),\n",
        "        width=850, height=450\n",
        "    )\n",
        "    save_and_show_plotly(fig_table, out_path.with_name(\"09b_Testing_Metrics_Table_interactive.png\"), width=850, height=450)\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 10. HYBRID CONVERGENCE PLOT\n",
        "# ------------------------------------------------------------------------------\n",
        "def plot_hybrid_convergence(history, out_path, dataset_title):\n",
        "    h = history.history if hasattr(history, \"history\") else history\n",
        "    train_loss = np.asarray(h[\"loss\"], dtype=float)\n",
        "    val_loss = np.asarray(h[\"val_loss\"], dtype=float)\n",
        "    epochs = np.arange(1, len(train_loss) + 1)\n",
        "    best_idx = int(np.argmin(val_loss))\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(10.5, 5.8), dpi=200)\n",
        "    style_axis(ax)\n",
        "    ax.plot(epochs, train_loss, color=\"#1f4e79\", linewidth=2.4, label=\"Training Loss (MSE)\")\n",
        "    ax.plot(epochs, val_loss, color=\"#f39c12\", linewidth=2.4, linestyle=\"--\", label=\"Validation Loss (MSE)\")\n",
        "    ax.scatter([epochs[best_idx]], [val_loss[best_idx]], color=\"#d62728\", marker=\"*\", s=150, zorder=5, label=f\"Best validation epoch = {epochs[best_idx]}\")\n",
        "    ax.axvline(epochs[best_idx], color=\"#d62728\", linestyle=\":\", linewidth=1.3)\n",
        "    ax.set_title(f\"Hybrid LSTM-GRU Training and Validation Convergence — {dataset_title}\", fontweight=\"bold\")\n",
        "    ax.set_xlabel(\"Epoch\", fontweight=\"bold\")\n",
        "    ax.set_ylabel(\"Mean Squared Error (scaled)\", fontweight=\"bold\")\n",
        "    ax.legend(frameon=True, facecolor=\"white\", edgecolor=\"black\")\n",
        "    fig.tight_layout()\n",
        "    save_and_show_figure(fig, out_path, dpi=300)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "id": "b72635d1",
      "metadata": {},
      "outputs": [],
      "source": [
        "def train_one_dataset(dataset_key, filename):\n",
        "    dataset_start = time.time()\n",
        "    dataset_titles = {\n",
        "        \"post_monsoon_1994_2023\": \"Post-Monsoon Season (1994–2023)\",\n",
        "        \"pre_monsoon_2014_2024\": \"Pre-Monsoon Season (2014–2024)\",\n",
        "        \"pre_monsoon_2004_2013\": \"Pre-Monsoon Season (2004–2013)\",\n",
        "        \"pre_monsoon_1994_2003\": \"Pre-Monsoon Season (1994–2003)\",\n",
        "    }\n",
        "    dataset_title = dataset_titles[dataset_key]\n",
        "\n",
        "    dataset_dir = OUTPUT_ROOT / dataset_key\n",
        "    model_dir = dataset_dir / \"saved_models\"\n",
        "    fig_dir = dataset_dir / \"figures\"\n",
        "    table_dir = dataset_dir / \"tables\"\n",
        "    for d in [dataset_dir, model_dir, fig_dir, table_dir]:\n",
        "        d.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 90)\n",
        "    print(f\"DATASET: {dataset_title}\")\n",
        "    print(f\"FILE: {filename}\")\n",
        "    print(\"=\" * 90)\n",
        "\n",
        "    df, info = load_and_engineer_dataset(filename)\n",
        "    with open(dataset_dir / \"dataset_profile.json\", \"w\") as f:\n",
        "        json.dump(info, f, indent=2)\n",
        "\n",
        "    print(\n",
        "        f\"Rows={len(df):,} | Wells={df.well_id.nunique():,} | \"\n",
        "        f\"Dates={df.date.min().date()} -> {df.date.max().date()}\"\n",
        "    )\n",
        "\n",
        "    corr = df[FEATURE_COLS + [\"groundwater_level\"]].corr()\n",
        "    corr.to_csv(table_dir / \"03_Correlation_Matrix.csv\")\n",
        "\n",
        "    train_df, val_df, test_df, train_cut, test_cut = chronological_split(df)\n",
        "    print(f\"Train: {train_df.date.min().date()} -> {train_df.date.max().date()} | {len(train_df):,} rows\")\n",
        "    print(f\"Val:   {val_df.date.min().date()} -> {val_df.date.max().date()} | {len(val_df):,} rows\")\n",
        "    print(f\"Test:  {test_df.date.min().date()} -> {test_df.date.max().date()} | {len(test_df):,} rows\")\n",
        "\n",
        "    sequences, scaler_x, scaler_y = prepare_sequences(df, train_df, val_df, test_df)\n",
        "    for split in [\"train\", \"val\", \"test\"]:\n",
        "        print(f\"{split.title():10s}: X={sequences[split]['X'].shape}, y={sequences[split]['y'].shape}\")\n",
        "\n",
        "    train_ds = (\n",
        "        tf.data.Dataset.from_tensor_slices(\n",
        "            (sequences[\"train\"][\"X\"], sequences[\"train\"][\"y\"])\n",
        "        )\n",
        "        .shuffle(min(20000, len(sequences[\"train\"][\"X\"])), seed=SEED)\n",
        "        .batch(BATCH_SIZE)\n",
        "        .prefetch(tf.data.AUTOTUNE)\n",
        "    )\n",
        "    val_ds = (\n",
        "        tf.data.Dataset.from_tensor_slices(\n",
        "            (sequences[\"val\"][\"X\"], sequences[\"val\"][\"y\"])\n",
        "        )\n",
        "        .batch(BATCH_SIZE)\n",
        "        .prefetch(tf.data.AUTOTUNE)\n",
        "    )\n",
        "\n",
        "    models = {}\n",
        "    histories = {}\n",
        "    input_shape = sequences[\"train\"][\"X\"].shape[1:]\n",
        "\n",
        "    for model_name, builder in MODEL_BUILDERS.items():\n",
        "        print(f\"\\n[TRAINING] {model_name} — {dataset_title}\")\n",
        "        model = builder(input_shape)\n",
        "        callbacks = [\n",
        "            EarlyStopping(\n",
        "                monitor=\"val_loss\",\n",
        "                patience=EARLY_STOPPING_PATIENCE,\n",
        "                restore_best_weights=True,\n",
        "                verbose=1,\n",
        "            ),\n",
        "            ReduceLROnPlateau(\n",
        "                monitor=\"val_loss\",\n",
        "                factor=0.5,\n",
        "                patience=LR_PATIENCE,\n",
        "                min_lr=1e-5,\n",
        "                verbose=1,\n",
        "            ),\n",
        "        ]\n",
        "\n",
        "        history = model.fit(\n",
        "            train_ds,\n",
        "            validation_data=val_ds,\n",
        "            epochs=EPOCHS,\n",
        "            callbacks=callbacks,\n",
        "            verbose=1,\n",
        "        )\n",
        "\n",
        "        models[model_name] = model\n",
        "        histories[model_name] = history\n",
        "        model_file = model_name.lower().replace(\" \", \"_\").replace(\"-\", \"_\")\n",
        "        model.save(model_dir / f\"{model_file}.keras\")\n",
        "        pd.DataFrame(history.history).to_csv(\n",
        "            table_dir / f\"{model_file}_history.csv\", index=False\n",
        "        )\n",
        "\n",
        "    observations = {\n",
        "        \"Training\": scaler_y.inverse_transform(sequences[\"train\"][\"y\"]).ravel(),\n",
        "        \"Testing\": scaler_y.inverse_transform(sequences[\"test\"][\"y\"]).ravel(),\n",
        "    }\n",
        "\n",
        "    prediction_sets = {\"Training\": {}, \"Testing\": {}}\n",
        "    for model_name, model in models.items():\n",
        "        prediction_sets[\"Training\"][model_name] = scaler_y.inverse_transform(\n",
        "            model.predict(sequences[\"train\"][\"X\"], batch_size=1024, verbose=0)\n",
        "        ).ravel()\n",
        "        prediction_sets[\"Testing\"][model_name] = scaler_y.inverse_transform(\n",
        "            model.predict(sequences[\"test\"][\"X\"], batch_size=1024, verbose=0)\n",
        "        ).ravel()\n",
        "\n",
        "    train_pred_df = pd.DataFrame({\n",
        "        \"Date\": pd.to_datetime(sequences[\"train\"][\"dates\"]),\n",
        "        \"Observed\": observations[\"Training\"],\n",
        "    })\n",
        "    test_pred_df = pd.DataFrame({\n",
        "        \"Date\": pd.to_datetime(sequences[\"test\"][\"dates\"]),\n",
        "        \"Observed\": observations[\"Testing\"],\n",
        "    })\n",
        "\n",
        "    for name in MODEL_COLORS:\n",
        "        train_pred_df[name] = prediction_sets[\"Training\"][name]\n",
        "        test_pred_df[name] = prediction_sets[\"Testing\"][name]\n",
        "\n",
        "    train_pred_df.to_csv(table_dir / \"Training_Predictions_All_Models.csv\", index=False)\n",
        "    test_pred_df.to_csv(table_dir / \"Testing_Predictions_All_Models.csv\", index=False)\n",
        "\n",
        "    train_metrics = make_metric_table(prediction_sets[\"Training\"], observations[\"Training\"])\n",
        "    test_metrics = make_metric_table(prediction_sets[\"Testing\"], observations[\"Testing\"])\n",
        "\n",
        "    train_metrics.to_csv(table_dir / \"Training_Statistical_Metrics.csv\", index=False)\n",
        "    test_metrics.to_csv(table_dir / \"Testing_Statistical_Metrics.csv\", index=False)\n",
        "\n",
        "    metric_order = [\"RMSE\",\"MAE\",\"R2\",\"Pearson_r\",\"KGE\",\"NSE\",\"NRMSE\",\"Willmott_d\",\"LMI\",\"MSE\",\"MAPE_%\"]\n",
        "    train_wide = train_metrics.set_index(\"Model\")[metric_order].T\n",
        "    test_wide = test_metrics.set_index(\"Model\")[metric_order].T\n",
        "    train_wide.to_csv(table_dir / \"Training_Metrics_Thesis_Format.csv\")\n",
        "    test_wide.to_csv(table_dir / \"Testing_Metrics_Thesis_Format.csv\")\n",
        "\n",
        "    try:\n",
        "        with pd.ExcelWriter(\n",
        "            table_dir / \"Statistical_Metrics_Training_Testing.xlsx\",\n",
        "            engine=\"openpyxl\",\n",
        "        ) as writer:\n",
        "            train_wide.to_excel(writer, sheet_name=\"Training Metrics\")\n",
        "            test_wide.to_excel(writer, sheet_name=\"Testing Metrics\")\n",
        "            corr.to_excel(writer, sheet_name=\"Correlation Matrix\")\n",
        "            train_metrics.to_excel(writer, sheet_name=\"Training Long\", index=False)\n",
        "            test_metrics.to_excel(writer, sheet_name=\"Testing Long\", index=False)\n",
        "    except Exception as exc:\n",
        "        print(\"Excel export skipped:\", exc)\n",
        "\n",
        "    combined_pred_df = pd.concat([\n",
        "        train_pred_df.assign(Partition=\"Training\"),\n",
        "        test_pred_df.assign(Partition=\"Testing\"),\n",
        "    ], ignore_index=True)\n",
        "\n",
        "    # --------------------------------------------------------------------------\n",
        "    # GENERATE AND DISPLAY ALL PUBLICATION & INTERACTIVE VISUALIZATIONS\n",
        "    # --------------------------------------------------------------------------\n",
        "    print(\"\\n[GENERATING PUBLICATION & INTERACTIVE FIGURES]\")\n",
        "    plot_observed_timeline(df, fig_dir / \"00_Observed_Regional_Timeline.png\", dataset_title)\n",
        "    plot_loss_histories(histories, fig_dir / \"01_Training_Validation_Loss.png\", dataset_title)\n",
        "    plot_time_series(combined_pred_df, test_cut, fig_dir / \"02_Time_Series_Observed_vs_Predicted.png\", dataset_title)\n",
        "    plot_correlation_matrix(df, fig_dir / \"03_Correlation_Matrix.png\", dataset_title)\n",
        "    plot_parity(\n",
        "        prediction_sets[\"Training\"], observations[\"Training\"],\n",
        "        prediction_sets[\"Testing\"], observations[\"Testing\"],\n",
        "        fig_dir / \"04_Scatter_Observed_vs_Predicted.png\", dataset_title,\n",
        "    )\n",
        "    plot_residuals(test_pred_df, fig_dir / \"05_Test_Residuals_vs_Time.png\", dataset_title)\n",
        "    plot_error_distributions(test_pred_df, fig_dir / \"06_Test_Residual_Distributions.png\", dataset_title)\n",
        "\n",
        "    taylor_training = make_taylor_dataframe(prediction_sets[\"Training\"], observations[\"Training\"])\n",
        "    taylor_testing = make_taylor_dataframe(prediction_sets[\"Testing\"], observations[\"Testing\"])\n",
        "    taylor_training.to_csv(table_dir / \"Taylor_Statistics_Training.csv\", index=False)\n",
        "    taylor_testing.to_csv(table_dir / \"Taylor_Statistics_Testing.csv\", index=False)\n",
        "    plot_taylor(\n",
        "        {\"Training\": taylor_training, \"Testing\": taylor_testing},\n",
        "        fig_dir / \"07_Taylor_Diagram_Training_Testing.png\", dataset_title,\n",
        "    )\n",
        "\n",
        "    plot_performance(\n",
        "        train_metrics, test_metrics,\n",
        "        fig_dir / \"08_Model_Performance_Comparison.png\", dataset_title,\n",
        "    )\n",
        "    plot_statistical_tables(\n",
        "        train_metrics, test_metrics,\n",
        "        fig_dir / \"09_Statistical_Metrics_Training_Testing.png\", dataset_title,\n",
        "    )\n",
        "    plot_hybrid_convergence(\n",
        "        histories[\"Hybrid LSTM-GRU\"],\n",
        "        fig_dir / \"10_Hybrid_LSTM_GRU_Convergence.png\", dataset_title,\n",
        "    )\n",
        "\n",
        "    import joblib\n",
        "    joblib.dump(scaler_x, model_dir / \"scaler_X.joblib\")\n",
        "    joblib.dump(scaler_y, model_dir / \"scaler_y.joblib\")\n",
        "    joblib.dump(\n",
        "        {\n",
        "            \"feature_cols\": FEATURE_COLS,\n",
        "            \"lookback\": LOOKBACK,\n",
        "            \"target\": \"groundwater_level\",\n",
        "            \"train_ratio\": TRAIN_RATIO,\n",
        "            \"validation_ratio\": VAL_RATIO,\n",
        "            \"dataset\": dataset_title,\n",
        "        },\n",
        "        model_dir / \"model_metadata.joblib\",\n",
        "    )\n",
        "\n",
        "    print(\"\\nTESTING METRICS\")\n",
        "    print(test_metrics[[\"Model\",\"RMSE\",\"MAE\",\"R2\",\"Pearson_r\",\"KGE\",\"NSE\"]].round(4).to_string(index=False))\n",
        "\n",
        "    elapsed = time.time() - dataset_start\n",
        "    print(f\"\\nCompleted {dataset_title} in {elapsed/60:.2f} minutes.\")\n",
        "    print(f\"Outputs: {dataset_dir}\")\n",
        "\n",
        "    del train_ds, val_ds, train_pred_df, test_pred_df, combined_pred_df\n",
        "    del train_metrics, test_metrics, sequences, scaler_x, scaler_y, df, train_df, val_df, test_df\n",
        "    for model in models.values():\n",
        "        del model\n",
        "    try:\n",
        "        tf.keras.backend.clear_session()\n",
        "    except Exception:\n",
        "        pass\n",
        "    gc.collect()\n",
        "\n",
        "    return {\n",
        "        \"Dataset\": dataset_title,\n",
        "        \"Output_Directory\": str(dataset_dir),\n",
        "    }\n"
      ]
    },
