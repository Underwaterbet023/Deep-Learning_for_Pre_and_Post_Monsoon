            "\u001b[1m10/10\u001b[0m \u001b[32m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 9ms/step - loss: 0.0062 - mae: 0.0556 - val_loss: 0.0061 - val_mae: 0.0531 - learning_rate: 0.0020\n",
            "Epoch 3/40\n",
            "\u001b[1m10/10\u001b[0m \u001b[32m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 9ms/step - loss: 0.0051 - mae: 0.0501 - val_loss: 0.0060 - val_mae: 0.0480 - learning_rate: 0.0020\n",
            "Epoch 4/40\n",
            "\u001b[1m10/10\u001b[0m \u001b[32m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 11ms/step - loss: 0.0049 - mae: 0.0484 - val_loss: 0.0056 - val_mae: 0.0466 - learning_rate: 0.0020\n",
            "Epoch 5/40\n",
            "\u001b[1m10/10\u001b[0m \u001b[32m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 10ms/step - loss: 0.0045 - mae: 0.0471 - val_loss: 0.0059 - val_mae: 0.0479 - learning_rate: 0.0020\n",
            "Epoch 6/40\n",
            "\u001b[1m10/10\u001b[0m \u001b[32m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 10ms/step - loss: 0.0046 - mae: 0.0474 - val_loss: 0.0066 - val_mae: 0.0495 - learning_rate: 0.0020\n",
            "Epoch 7/40\n",
