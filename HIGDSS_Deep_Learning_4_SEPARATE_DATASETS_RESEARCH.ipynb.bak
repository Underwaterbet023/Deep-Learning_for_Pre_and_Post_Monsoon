      "source": [
        "run_summary = []\n",
        "for dataset_key, filename in DATASET_FILES.items():\n",
        "    run_summary.append(train_one_dataset(dataset_key, filename))\n",
        "\n",
        "summary_df = pd.DataFrame(run_summary)\n",
        "summary_df.to_csv(OUTPUT_ROOT / \"Four_Dataset_Run_Summary.csv\", index=False)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"ALL FOUR DATASETS COMPLETED\")\n",
        "print(\"=\" * 90)\n",
        "print(summary_df.to_string(index=False))\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(\"Output root:\", OUTPUT_ROOT.resolve())\n",
        "for dataset_key in DATASET_FILES:\n",
        "    d = OUTPUT_ROOT / dataset_key\n",
        "    print(f\"\\n{dataset_key}/\")\n",
        "    if d.exists():\n",
        "        for p in sorted(d.rglob(\"*\")):\n",
        "            if p.is_file():\n",
        "                print(\"  \", p.relative_to(d))\n"
      ]
    }
